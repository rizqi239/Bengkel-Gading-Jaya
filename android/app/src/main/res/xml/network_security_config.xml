<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows HTTP cleartext traffic for local development & testing (e.g. 10.0.2.2 or local LAN IP) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
